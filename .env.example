# DeepSeek auth token: in chat.deepseek.com DevTools run copy(localStorage.getItem('userToken')) and use the "value" field
DEEPSEEK_AUTH_TOKEN=

# Or sign in with your DeepSeek account
DEEPSEEK_EMAIL=
DEEPSEEK_PASSWORD=
DEEPSEEK_SAVE_LOGIN=true
DEEPSEEK_LOGIN_FILE=login.json

# Optional: Cookies from your browser session (for WAF/CSRF)
DEEPSEEK_COOKIES=aws-waf-token=...; ds_session_id=...

# Optional: Cookie refresh support
DEEPSEEK_COOKIE_FILE=cookies.json
DEEPSEEK_COOKIE_REFRESH_COMMAND=

# Optional: Protect this proxy with an API key
# Set this to require clients to pass Bearer <API_KEY>
API_KEY=

# Address and port to listen on. Keep 127.0.0.1 and put nginx in front for public access.
HOST=127.0.0.1
PORT=9123

# Keep the DeepSeek chats the proxy creates (default false: deleted after each reply)
DEEPSEEK_KEEP_SESSIONS=false

# Taalas (chatjimmy.ai) — no auth required, enabled by default
# Set to "false" to disable the Taalas provider routes
# TAALAS_ENABLED=true

